<?php
// Copie para api/env.php no desenvolvimento ou configure as mesmas variáveis
// no painel do Render. Nunca coloque credenciais no React/VITE_API_URL.
define('DB_DSN', getenv('DB_DSN') ?: 'mysql:host=127.0.0.1;port=3306;dbname=prolobby;charset=utf8mb4');
define('DB_USER', getenv('DB_USER') ?: 'root');
define('DB_SENHA', getenv('DB_PASSWORD') ?: '');
define('FRONTEND_URL', getenv('FRONTEND_URL') ?: 'http://localhost:5173');
define('APP_DEBUG', filter_var(getenv('APP_DEBUG') ?: 'false', FILTER_VALIDATE_BOOLEAN));

if (getenv('PANDASCORE_TOKEN')) {
    define('PANDASCORE_TOKEN', getenv('PANDASCORE_TOKEN'));
}
if (getenv('ADMIN_CHAVE')) {
    define('ADMIN_CHAVE', getenv('ADMIN_CHAVE'));
}

// Capas dos jogos que não estão na Steam (opcional). Chaves grátis do app criado em https://dev.twitch.tv/console
// Na hospedagem sem variáveis de ambiente, use define('IGDB_CLIENT_ID', '...'); e define('IGDB_CLIENT_SECRET', '...');
if (getenv('IGDB_CLIENT_ID') && getenv('IGDB_CLIENT_SECRET')) {
    define('IGDB_CLIENT_ID', getenv('IGDB_CLIENT_ID'));
    define('IGDB_CLIENT_SECRET', getenv('IGDB_CLIENT_SECRET'));
}
